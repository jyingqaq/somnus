  "description": "本地优先的写作与续写工具",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#f3f3f6",
  "theme_color": "#f3f3f6",
  "prefer_related_applications": false,
  "icons": [
